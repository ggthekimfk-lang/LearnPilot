VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Server secrets are configured with Supabase CLI, never VITE_*:
# GEMINI_API_KEY
# GEMINI_MODEL (a model with Gemini structured output support)
# APP_ORIGIN: synchronized from supabase/functions/_shared/app-origins.ts
# Use npm run deploy:backend; verify with npm run check:origins (no Gemini calls).

