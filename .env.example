VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Server secrets are configured with Supabase CLI, never VITE_*:
# OPENAI_API_KEY
# OPENAI_MODEL (a model with Responses API structured output support)
# APP_ORIGIN (the exact frontend origin, e.g. https://leanpilot.example)
